{
  "name": "hmg-app",
  "version": "1.0.0",
  "description": "HMG AI-Powered Doctor Appointment Platform",
  "private": true,
  "main": "electron/main.js",
  "author": "HMG Healthcare",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder --win --x64 --publish never",
    "electron:pack": "next build && electron-builder --dir",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.363.0",
    "next": "14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/jest-dom": "^6.4.2",
    "ts-jest": "^29.1.4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hmg.healthcare.app",
    "productName": "HMG Healthcare",
    "copyright": "Copyright © 2025 HMG Healthcare Group",
    "directories": { "output": "dist" },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "HMG-Healthcare-Setup-v${version}-Windows10-11-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HMG Healthcare",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
