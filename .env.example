# HMG Healthcare Platform — Environment Variables
# Copy this file to .env and fill in your values

# ── AI Keys ───────────────────────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=hmg_secret_change_in_prod
DATABASE_URL=postgresql://hmg:hmg_secret_change_in_prod@localhost:5432/hmg_healthcare

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=hmg_redis_2025
REDIS_URL=redis://:hmg_redis_2025@localhost:6379

# ── n8n Workflow Orchestration ────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=hmg_n8n_2025
N8N_ENCRYPTION_KEY=hmg_encryption_key_change_in_prod
N8N_WEBHOOK_URL=http://localhost:5678
